{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://REPLACE-WITH-PROJECT-REF.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "REPLACE-WITH-PUBLISHABLE-KEY",
        "EXPO_PUBLIC_REVIEW_EMAIL": "review@REPLACE-WITH-YOUR-DOMAIN"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
