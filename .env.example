# Copy this file to .env.local for running the app on your computer.
# The same two values go into eas.json for real builds.
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE-WITH-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE-WITH-PUBLISHABLE-KEY
# Optional: an account App Store / Play Store reviewers sign in to with a password.
EXPO_PUBLIC_REVIEW_EMAIL=
